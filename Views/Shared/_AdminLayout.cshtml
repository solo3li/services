<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    <style>
        .admin-sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
            border-right: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .admin-content {
            margin-left: 280px;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .admin-nav-link {
            color: rgba(255, 255, 255, 0.7);
            border-radius: 8px;
            margin-bottom: 4px;
            transition: all 0.3s ease;
        }

        .admin-nav-link:hover, .admin-nav-link.active {
            color: var(--bs-white);
            background: rgba(139, 92, 246, 0.15);
        }

        .admin-nav-link i {
            width: 24px;
            text-align: center;
        }

        @@media (max-width: 991.98px) {
            .admin-sidebar {
                transform: translateX(-100%);
                transition: transform 0.3s ease;
            }
            .admin-sidebar.show {
                transform: translateX(0);
            }
            .admin-content {
                margin-left: 0;
            }
        }
    </style>
</head>
<body class="bg-black text-white">

    <!-- Mobile Header -->
    <div class="d-lg-none glass-panel p-3 d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-25 sticky-top">
        <a class="navbar-brand fw-bold text-white fs-5" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-layers-fill text-primary me-2"></i>Admin Panel
        </a>
        <button class="btn btn-dark border-secondary" type="button" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
            <i class="bi bi-list"></i>
        </button>
    </div>

    <!-- Sidebar -->
    <nav id="adminSidebar" class="admin-sidebar glass-panel d-flex flex-column p-3">
        <a class="d-flex align-items-center mb-4 text-white text-decoration-none px-2" asp-controller="Home" asp-action="Index">
            <i class="bi bi-layers-fill text-primary fs-3 me-2"></i>
            <span class="fs-4 fw-bold">Platform</span>
        </a>
        
        <div class="small text-muted fw-bold mb-2 px-2 text-uppercase" style="letter-spacing: 1px;">System</div>
        <ul class="nav nav-pills flex-column mb-4">
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Dashboard" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
                   asp-controller="Admin" asp-action="Dashboard">
                    <i class="bi bi-grid-1x2-fill me-2"></i> Dashboard
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Users" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
                   asp-controller="Admin" asp-action="Users">
                    <i class="bi bi-people-fill me-2"></i> Users Management
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Kyc" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
                   asp-controller="Admin" asp-action="Kyc">
                    <i class="bi bi-person-vcard-fill me-2"></i> KYC Approvals
                </a>
            </li>
        </ul>

        <div class="small text-muted fw-bold mb-2 px-2 text-uppercase" style="letter-spacing: 1px;">Catalog</div>
        <ul class="nav nav-pills flex-column mb-4">
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminCategories" ? "active" : "")" 
                   asp-controller="AdminCategories" asp-action="Index">
                    <i class="bi bi-folder-fill me-2"></i> Categories
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminServices" ? "active" : "")" 
                   asp-controller="AdminServices" asp-action="Index">
                    <i class="bi bi-briefcase-fill me-2"></i> Services
                </a>
            </li>
        </ul>

        <div class="small text-muted fw-bold mb-2 px-2 text-uppercase" style="letter-spacing: 1px;">Operations</div>
        <ul class="nav nav-pills flex-column mb-4">
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminOrders" ? "active" : "")" 
                   asp-controller="AdminOrders" asp-action="Index">
                    <i class="bi bi-box-seam-fill me-2"></i> Orders
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminPayments" ? "active" : "")" 
                   asp-controller="AdminPayments" asp-action="Index">
                    <i class="bi bi-credit-card-fill me-2"></i> Payments
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminTickets" ? "active" : "")" 
                   asp-controller="AdminTickets" asp-action="Index">
                    <i class="bi bi-ticket-fill me-2"></i> Support Tickets
                </a>
            </li>
        </ul>

        <div class="small text-muted fw-bold mb-2 px-2 text-uppercase" style="letter-spacing: 1px;">Configuration</div>
        <ul class="nav nav-pills flex-column mt-auto mb-3">
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "AdminRoles" ? "active" : "")" 
                   asp-controller="AdminRoles" asp-action="Index">
                    <i class="bi bi-shield-lock-fill me-2"></i> Roles & Permissions
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link admin-nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Settings" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")" 
                   asp-controller="Admin" asp-action="Settings">
                    <i class="bi bi-gear-fill me-2"></i> Settings
                </a>
            </li>
            <li class="nav-item mt-2 pt-2 border-top border-secondary border-opacity-25">
                <a class="nav-link admin-nav-link text-danger" asp-controller="Auth" asp-action="Logout">
                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                </a>
            </li>
        </ul>
    </nav>

    <!-- Main Content -->
    <div class="admin-content">
        <!-- Top Navbar in Admin -->
        <header class="glass-panel border-bottom border-secondary border-opacity-25 sticky-top p-3 d-none d-lg-flex justify-content-end align-items-center">
            <div class="dropdown">
                <button class="btn btn-link text-white text-decoration-none dropdown-toggle d-flex align-items-center" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2 text-white fw-bold" style="width: 32px; height: 32px; font-size: 14px;">
                        A
                    </div>
                    <span>Admin User</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark glass-panel border-secondary">
                    <li><a class="dropdown-item" asp-controller="Home" asp-action="Index"><i class="bi bi-house me-2"></i>Back to Main Site</a></li>
                    <li><hr class="dropdown-divider border-secondary"></li>
                    <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                </ul>
            </div>
        </header>

        <main class="flex-grow-1 p-3 p-lg-4">
            <!-- Global Notifications Container -->
            <div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;"></div>

            @RenderBody()
        </main>
        
        <footer class="p-4 text-center text-muted small border-top border-secondary border-opacity-25 mt-auto">
            &copy; 2026 - Platform Admin Panel
        </footer>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <!-- SignalR Client -->
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <!-- Notifications Script -->
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
