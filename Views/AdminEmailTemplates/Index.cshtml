@model List<ServicesApp.Models.Entities.EmailTemplate>
@{
    ViewData["Title"] = "Email Templates";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold">Email Templates</h1>
                <p class="text-muted">Customize the content and design of system-generated emails</p>
            </div>
            <a asp-controller="Admin" asp-action="EmailSettings" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-2"></i> SMTP Settings
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="glass-card rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="border-secondary text-muted small py-3">Template Name</th>
                        <th class="border-secondary text-muted small py-3">Subject</th>
                        <th class="border-secondary text-muted small py-3">Last Updated</th>
                        <th class="border-secondary text-muted small py-3 text-end">Action</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var t in Model)
                    {
                        <tr>
                            <td class="border-secondary py-3">
                                <div class="fw-bold">@t.Name</div>
                                <div class="text-muted small">Slug: @t.Slug</div>
                            </td>
                            <td class="border-secondary py-3 text-white">@t.Subject</td>
                            <td class="border-secondary py-3 text-muted small">@t.UpdatedAt.ToString("MMM dd, yyyy")</td>
                            <td class="border-secondary py-3 text-end">
                                <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil-square me-1"></i> Edit Template
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">No templates found. Run seeding to add defaults.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
