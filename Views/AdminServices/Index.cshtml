@using ServicesApp.Models.Entities
@model List<Service>
@{
    ViewData["Title"] = "Manage Services";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold">Services Management</h1>
            <p class="text-muted">Review, activate, and manage all platform services</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="glass-card rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="border-secondary text-muted small py-3">Service</th>
                        <th class="border-secondary text-muted small py-3">Executor</th>
                        <th class="border-secondary text-muted small py-3">Price</th>
                        <th class="border-secondary text-muted small py-3">Status</th>
                        <th class="border-secondary text-muted small py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var srv in Model)
                    {
                        <tr>
                            <td class="border-secondary py-3">
                                <div class="fw-bold text-truncate" style="max-width: 250px;" title="@srv.Title">@srv.Title</div>
                                <div class="small text-muted"><i class="bi bi-tag-fill me-1"></i> @srv.Category.Name</div>
                            </td>
                            <td class="border-secondary py-3 text-muted">
                                @if (srv.Executor != null)
                                {
                                    @srv.Executor.FullName
                                }
                                else
                                {
                                    <span class="text-danger">Unknown</span>
                                }
                            </td>
                            <td class="border-secondary py-3 fw-bold text-success">$@srv.Price.ToString("0.00")</td>
                            <td class="border-secondary py-3">
                                @if (srv.IsActive)
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Active</span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Inactive</span>
                                }
                            </td>
                            <td class="border-secondary py-3 text-end">
                                <form asp-action="ToggleStatus" asp-route-id="@srv.Id" method="post" class="d-inline me-1">
                                    @if (srv.IsActive)
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3">Activate</button>
                                    }
                                </form>
                                <form asp-action="Delete" asp-route-id="@srv.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Delete this service permanently?');">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="border-secondary py-4 text-center text-muted">No services found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
