@using ServicesApp.Controllers
@using ServicesApp.Models.Entities
@model CreateServiceViewModel
@{
    ViewData["Title"] = "Create a New Service";
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-controller="Kyc" asp-action="Status" class="btn btn-outline-secondary btn-sm rounded-pill me-3"><i class="bi bi-arrow-left"></i> Back</a>
                <h1 class="h3 fw-bold mb-0">Create a New Service</h1>
            </div>

            <form asp-action="Create" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger bg-opacity-10 border-danger border-opacity-25 text-danger rounded-3"></div>

                <div class="glass-card p-4 p-md-5 mb-4">
                    <h3 class="h5 mb-4 border-bottom border-secondary border-opacity-25 pb-3">Service Details</h3>
                    
                    <div class="mb-4">
                        <label asp-for="Title" class="form-label text-muted small fw-bold">Service Title <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control bg-dark text-white border-secondary" placeholder="I will do something I'm really good at">
                        <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                        <div class="form-text text-muted mt-2">Make it catchy and descriptive.</div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="CategoryId" class="form-label text-muted small fw-bold">Category <span class="text-danger">*</span></label>
                            <select asp-for="CategoryId" class="form-select bg-dark text-white border-secondary">
                                <option value="">Select a category</option>
                                @if (categories != null)
                                {
                                    foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label asp-for="Tags" class="form-label text-muted small fw-bold">Search Tags</label>
                            <input asp-for="Tags" class="form-control bg-dark text-white border-secondary" placeholder="e.g. logo, branding, vector">
                            <span asp-validation-for="Tags" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Description" class="form-label text-muted small fw-bold">Service Description <span class="text-danger">*</span></label>
                        <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="8" placeholder="Describe your service in detail..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="glass-card p-4 p-md-5 mb-4">
                    <h3 class="h5 mb-4 border-bottom border-secondary border-opacity-25 pb-3">Pricing & Delivery</h3>
                    
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <label asp-for="Price" class="form-label text-muted small fw-bold">Price ($) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-dark border-secondary text-white">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="5" class="form-control bg-dark text-white border-secondary" placeholder="50.00">
                            </div>
                            <span asp-validation-for="Price" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text text-muted mt-2">Minimum price is $5.00</div>
                        </div>
                        
                        <div class="col-12 col-md-6">
                            <label asp-for="DeliveryDays" class="form-label text-muted small fw-bold">Delivery Time (Days) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="DeliveryDays" type="number" min="1" max="90" class="form-control bg-dark text-white border-secondary" placeholder="3">
                                <span class="input-group-text bg-dark border-secondary text-white">Days</span>
                            </div>
                            <span asp-validation-for="DeliveryDays" class="text-danger small mt-1 d-block"></span>
                        </div>
                    </div>
                </div>

                <div class="glass-card p-4 p-md-5 mb-5">
                    <h3 class="h5 mb-4 border-bottom border-secondary border-opacity-25 pb-3">Media</h3>
                    
                    <div>
                        <label asp-for="ThumbnailFile" class="form-label text-muted small fw-bold">Service Thumbnail Image</label>
                        <div class="file-upload-wrapper text-center p-5 border border-secondary border-dashed rounded-3 bg-dark bg-opacity-50 transition-all hover-bg-dark">
                            <i class="bi bi-cloud-arrow-up text-muted display-4 mb-3 d-block"></i>
                            <input asp-for="ThumbnailFile" class="form-control bg-dark text-white border-secondary mx-auto w-50" type="file" accept="image/*">
                            <div class="form-text mt-3">Upload a high-quality image that represents your service. 16:9 ratio recommended. Max 5MB.</div>
                        </div>
                        <span asp-validation-for="ThumbnailFile" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 glow-btn">Publish Service</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        .border-dashed { border-style: dashed !important; }
        .hover-bg-dark:hover { background-color: rgba(0,0,0,0.5) !important; cursor: pointer; }
    </style>
}
