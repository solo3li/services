@{
    ViewData["Title"] = "Open Support Ticket";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a asp-action="List" class="btn btn-outline-secondary btn-sm rounded-pill me-3"><i class="bi bi-arrow-left"></i> Back to Tickets</a>
                <h1 class="h3 fw-bold mb-0">Open a Support Ticket</h1>
            </div>

            <div class="glass-card p-4 p-md-5 rounded-4">
                <form asp-action="Open" method="post">
                    <div asp-validation-summary="All" class="text-danger mb-4 small"></div>

                    @if (ViewBag.OrderId != null)
                    {
                        <div class="alert alert-info bg-info bg-opacity-10 text-info border-info border-opacity-25 rounded-3 mb-4">
                            <i class="bi bi-info-circle me-2"></i> This ticket will be linked to Order #@ViewBag.OrderId
                            <input type="hidden" name="orderId" value="@ViewBag.OrderId" />
                        </div>
                    }

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Subject <span class="text-danger">*</span></label>
                        <input type="text" name="subject" class="form-control bg-dark text-white border-secondary" placeholder="Brief summary of your issue" required>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Category <span class="text-danger">*</span></label>
                        <select name="category" class="form-select bg-dark text-white border-secondary" required>
                            <option value="General Support">General Support</option>
                            <option value="Order Issue" selected="@(ViewBag.OrderId != null)">Order Issue</option>
                            <option value="Payment / Billing">Payment / Billing</option>
                            <option value="Account / Profile">Account / Profile</option>
                            <option value="Report User">Report a User</option>
                            <option value="Feature Request">Feature Request</option>
                        </select>
                    </div>

                    <div class="mb-5">
                        <label class="form-label text-muted small fw-bold">Message <span class="text-danger">*</span></label>
                        <textarea name="message" class="form-control bg-dark text-white border-secondary" rows="6" placeholder="Please describe your issue in detail..." required></textarea>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 glow-btn">Submit Ticket</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
