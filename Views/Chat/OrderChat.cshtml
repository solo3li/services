@using ServicesApp.Models.Entities
@model List<Message>
@{
    ViewData["Title"] = "Order Chat #" + ViewBag.OrderId;
}

<div class="container py-4 h-100">
    <div class="row justify-content-center h-100">
        <div class="col-12 col-lg-8 d-flex flex-column" style="height: 80vh;">
            
            <!-- Chat Header -->
            <div class="glass-panel p-3 rounded-top-4 border-bottom border-secondary border-opacity-25 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <a asp-controller="Orders" asp-action="Tracking" asp-route-id="@ViewBag.OrderId" class="btn btn-sm btn-link text-white me-2"><i class="bi bi-arrow-left"></i></a>
                    <div>
                        <h5 class="mb-0 fw-bold h6">Order #@ViewBag.OrderId Chat</h5>
                        <small class="text-muted">Discuss requirements and delivery</small>
                    </div>
                </div>
            </div>

            <!-- Messages Area -->
            <div class="glass-panel flex-grow-1 p-4 overflow-auto bg-opacity-10" id="messagesList">
                <div class="text-center mb-4">
                    <div class="d-inline-block bg-dark bg-opacity-50 text-muted small px-3 py-1 rounded-pill border border-secondary border-opacity-25">
                        <i class="bi bi-shield-lock me-1"></i> Keep all communication on the platform for your safety.
                    </div>
                </div>

                @foreach (var msg in Model)
                {
                    bool isOwn = msg.SenderId == ViewBag.CurrentUserId;
                    
                    <div class="d-flex mb-4 @(isOwn ? "justify-content-end" : "justify-content-start")">
                        @if (!isOwn)
                        {
                            <div class="me-2 flex-shrink-0 mt-auto">
                                @if (!string.IsNullOrEmpty(msg.Sender?.Avatar))
                                {
                                    <img src="@msg.Sender.Avatar" class="rounded-circle" width="28" height="28" alt="">
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 28px; height: 28px; font-size: 10px;">
                                        @(msg.Sender?.FullName.Substring(0, 1) ?? "U")
                                    </div>
                                }
                            </div>
                        }
                        
                        <div style="max-width: 75%;">
                            <div class="p-3 rounded-4 @(isOwn ? "bg-primary text-white" : "bg-dark text-light border border-secondary border-opacity-50")" style="@(isOwn ? "border-bottom-right-radius: 4px !important;" : "border-bottom-left-radius: 4px !important;")">
                                @msg.Content
                            </div>
                            <div class="small text-muted mt-1 @(isOwn ? "text-end" : "text-start")" style="font-size: 0.7rem;">
                                @if(!isOwn) { <span class="fw-bold me-1">@msg.Sender?.FullName</span> }
                                @msg.SentAt.ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Input Area -->
            <div class="glass-panel p-3 rounded-bottom-4 border-top border-secondary border-opacity-25">
                <div class="input-group">
                    <input type="text" id="messageInput" class="form-control bg-dark text-white border-secondary rounded-start-pill ps-4 py-2" placeholder="Type a message..." autocomplete="off">
                    <button class="btn btn-primary rounded-end-pill px-4" type="button" id="sendBtn"><i class="bi bi-send-fill"></i></button>
                </div>
            </div>
            
        </div>
    </div>
</div>

<input type="hidden" id="orderId" value="@ViewBag.OrderId" />
<input type="hidden" id="currentUserId" value="@ViewBag.CurrentUserId" />

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        const orderId = document.getElementById("orderId").value;
        const currentUserId = document.getElementById("currentUserId").value;
        const msgList = document.getElementById("messagesList");
        
        msgList.scrollTop = msgList.scrollHeight;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/hubs/chat")
            .build();

        connection.on("ReceiveOrderMessage", function (data) {
            const isOwn = data.senderId === currentUserId;
            
            const div = document.createElement("div");
            div.className = `d-flex mb-4 ${isOwn ? "justify-content-end" : "justify-content-start"}`;
            
            let avatarHtml = '';
            let nameHtml = '';
            if (!isOwn) {
                if (data.senderAvatar) {
                    avatarHtml = `<div class="me-2 flex-shrink-0 mt-auto"><img src="${data.senderAvatar}" class="rounded-circle" width="28" height="28" alt=""></div>`;
                } else {
                    const initial = data.senderName ? data.senderName.substring(0, 1) : "U";
                    avatarHtml = `<div class="me-2 flex-shrink-0 mt-auto"><div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 28px; height: 28px; font-size: 10px;">${initial}</div></div>`;
                }
                nameHtml = `<span class="fw-bold me-1">${data.senderName}</span>`;
            }
            
            const bubbleClass = isOwn ? "bg-primary text-white" : "bg-dark text-light border border-secondary border-opacity-50";
            const radiusClass = isOwn ? "border-bottom-right-radius: 4px !important;" : "border-bottom-left-radius: 4px !important;";
            const alignClass = isOwn ? "text-end" : "text-start";
            
            const date = new Date(data.sentAt);
            const timeStr = date.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});
            
            div.innerHTML = `
                ${avatarHtml}
                <div style="max-width: 75%;">
                    <div class="p-3 rounded-4 ${bubbleClass}" style="${radiusClass}">
                        ${data.content.replace(/</g, "&lt;").replace(/>/g, "&gt;")}
                    </div>
                    <div class="small text-muted mt-1 ${alignClass}" style="font-size: 0.7rem;">
                        ${nameHtml}
                        ${timeStr}
                    </div>
                </div>
            `;
            
            msgList.appendChild(div);
            msgList.scrollTop = msgList.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinOrderChat", parseInt(orderId)).catch(err => console.error(err));
        }).catch(err => console.error(err.toString()));

        document.getElementById("sendBtn").addEventListener("click", function () {
            const input = document.getElementById("messageInput");
            const content = input.value.trim();
            if (content === "") return;

            connection.invoke("SendOrderMessage", parseInt(orderId), "", content)
                .then(() => { input.value = ""; })
                .catch(err => console.error(err.toString()));
        });

        document.getElementById("messageInput").addEventListener("keypress", function (e) {
            if (e.key === "Enter") {
                e.preventDefault();
                document.getElementById("sendBtn").click();
            }
        });
    </script>
}
