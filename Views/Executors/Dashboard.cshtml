@using ServicesApp.Models.Entities
@model List<Order>
@{
    ViewData["Title"] = "Freelancer Dashboard";
}

<div class="container py-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-5 fw-bold text-white mb-2">Freelancer Dashboard</h1>
            <p class="text-muted">Manage your orders and track your earnings</p>
        </div>
    </div>

    <!-- Stats row -->
    <div class="row g-4 mb-5">
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 h-100 border-primary border-opacity-50">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary bg-opacity-25 p-3 rounded-3 text-primary me-3">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-0">Total Earnings</p>
                        <h2 class="fw-bold mb-0">$@ViewBag.TotalEarnings.ToString("0.00")</h2>
                    </div>
                </div>
                <div class="small text-muted">After 15% platform commission</div>
            </div>
        </div>
        
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 h-100 border-info border-opacity-50">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-info bg-opacity-25 p-3 rounded-3 text-info me-3">
                        <i class="bi bi-clock-history fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-0">Pending Clearance</p>
                        <h2 class="fw-bold mb-0">$@ViewBag.PendingEarnings.ToString("0.00")</h2>
                    </div>
                </div>
                <div class="small text-muted">From active and delivered orders</div>
            </div>
        </div>
        
        <div class="col-12 col-md-4">
            <div class="glass-card p-4 h-100 border-success border-opacity-50">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success bg-opacity-25 p-3 rounded-3 text-success me-3">
                        <i class="bi bi-cart-check fs-4"></i>
                    </div>
                    <div>
                        <p class="text-muted small text-uppercase fw-bold mb-0">Active Orders</p>
                        <h2 class="fw-bold mb-0">@ViewBag.ActiveOrdersCount</h2>
                    </div>
                </div>
                <div class="small text-muted">Currently being processed</div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="glass-card rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0 text-white">Recent Received Orders</h5>
                    <a asp-controller="Orders" asp-action="List" class="btn btn-sm btn-outline-secondary rounded-pill">View All</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th class="border-secondary text-muted small py-3">ID</th>
                                <th class="border-secondary text-muted small py-3">Service</th>
                                <th class="border-secondary text-muted small py-3">Client</th>
                                <th class="border-secondary text-muted small py-3">Earnings</th>
                                <th class="border-secondary text-muted small py-3">Status</th>
                                <th class="border-secondary text-muted small py-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="border-top-0">
                            @foreach (var order in Model.Take(5))
                            {
                                <tr>
                                    <td class="border-secondary py-3 text-muted">#@order.Id</td>
                                    <td class="border-secondary py-3 fw-bold">@order.Service.Title</td>
                                    <td class="border-secondary py-3">@order.Client.FullName</td>
                                    <td class="border-secondary py-3 fw-bold text-success">$@((order.TotalPrice * 0.85m).ToString("0.00"))</td>
                                    <td class="border-secondary py-3">
                                        @{
                                            var badgeClass = order.Status switch
                                            {
                                                OrderStatus.Pending => "bg-warning text-dark",
                                                OrderStatus.InProgress => "bg-info text-dark",
                                                OrderStatus.Delivered => "bg-primary",
                                                OrderStatus.Completed => "bg-success",
                                                OrderStatus.Cancelled => "bg-danger",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass rounded-pill">@order.Status</span>
                                    </td>
                                    <td class="border-secondary py-3 text-end">
                                        <a asp-controller="Orders" asp-action="Tracking" asp-route-id="@order.Id" class="btn btn-sm btn-primary rounded-pill px-3">Manage</a>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="border-secondary text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        You haven't received any orders yet.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
