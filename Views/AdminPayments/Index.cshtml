@using ServicesApp.Models.Entities
@model List<Order>
@{
    ViewData["Title"] = "Manage Payments";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold">Payments Management</h1>
            <p class="text-muted">Review transactions and manage refunds</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="glass-card rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="border-secondary text-muted small py-3">Txn / Order ID</th>
                        <th class="border-secondary text-muted small py-3">Client</th>
                        <th class="border-secondary text-muted small py-3">Service</th>
                        <th class="border-secondary text-muted small py-3">Amount</th>
                        <th class="border-secondary text-muted small py-3">Date</th>
                        <th class="border-secondary text-muted small py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="border-secondary py-3">
                                <div class="fw-bold">TXN-@(order.Id.ToString().PadLeft(6, '0'))</div>
                                <div class="small text-muted">Order #@order.Id</div>
                            </td>
                            <td class="border-secondary py-3">@order.Client.FullName</td>
                            <td class="border-secondary py-3 text-truncate" style="max-width: 150px;">@order.Service.Title</td>
                            <td class="border-secondary py-3 fw-bold text-success">$@order.TotalPrice.ToString("0.00")</td>
                            <td class="border-secondary py-3 small text-muted">@order.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            <td class="border-secondary py-3 text-end">
                                <button class="btn btn-sm btn-outline-warning rounded-pill px-3" onclick="alert('Refund initiated via gateway (mock)');">Refund</button>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="border-secondary py-4 text-center text-muted">No transactions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
