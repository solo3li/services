<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SERVADO</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    
    <partial name="_Navbar" />

    <main role="main" class="flex-grow-1 position-relative" style="z-index: 1;">
        @RenderBody()
    </main>

    <!-- Global Toast Container -->
    <div id="toast-container"></div>

    <footer class="border-top border-secondary border-opacity-25 mt-auto py-4 bg-dark bg-opacity-50">
        <div class="container text-center text-muted small">
            <div class="mb-2">
                <i class="bi bi-layers-fill text-primary me-1"></i> <strong>SERVADO</strong> - Professional Freelancing Platform
            </div>
            &copy; @DateTime.Now.Year Servado. All rights reserved.
        </div>
    </footer>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    <!-- SignalR Client -->
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            // Global Notification System
            const notifConn = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/notification")
                .withAutomaticReconnect()
                .build();

            notifConn.on("ReceiveNotification", function(data) {
                // Update badge
                const badge = document.getElementById("notifBadge");
                if (!badge) {
                    const icon = document.querySelector("#notifDropdown i");
                    if (icon) {
                        icon.insertAdjacentHTML('afterend', '<span class="position-absolute top-25 start-75 translate-middle p-1 bg-danger border border-light rounded-circle" id="notifBadge"><span class="visually-hidden">New alerts</span></span>');
                    }
                }
                
                // Hide empty message
                const emptyMsg = document.getElementById("noNotifsMsg");
                if (emptyMsg) emptyMsg.style.display = "none";
                
                // Add to list
                const list = document.getElementById("notifList");
                if (list) {
                    const typeColor = data.type === 1 ? 'success' : (data.type === 2 ? 'warning' : 'primary');
                    const iconClass = data.type === 4 ? 'bi-chat-dots' : (data.type === 3 ? 'bi-box-seam' : 'bi-bell');
                    
                    const item = document.createElement("a");
                    item.className = "dropdown-item p-3 border-bottom border-secondary border-opacity-25 text-wrap";
                    item.href = data.actionUrl || "#";
                    item.innerHTML = `
                        <div class="d-flex align-items-start">
                            <div class="text-${typeColor} me-3 mt-1"><i class="bi ${iconClass} fs-5"></i></div>
                            <div>
                                <h6 class="mb-1 text-white small fw-bold">${data.title}</h6>
                                <p class="mb-0 text-muted small" style="font-size: 0.8rem;">${data.body}</p>
                            </div>
                        </div>
                    `;
                    list.insertBefore(item, list.firstChild);
                }

                // Show toast
                showToast(data.title, data.body, data.actionUrl);
            });

            notifConn.start().catch(err => console.error("Notification connection error:", err));

            function showToast(title, body, url) {
                const container = document.getElementById("toast-container");
                const toast = document.createElement("div");
                toast.className = "app-toast";
                toast.innerHTML = `
                    <div class="app-toast-header">
                        <i class="bi bi-bell-fill text-primary app-toast-icon"></i>
                        <span class="me-auto">${title}</span>
                        <button type="button" class="btn-close btn-close-white btn-sm ms-2" onclick="this.parentElement.parentElement.remove(); event.stopPropagation();"></button>
                    </div>
                    <div class="small text-muted mt-1">${body}</div>
                `;
                
                if (url) {
                    toast.onclick = () => window.location.href = url;
                }
                
                container.appendChild(toast);
                
                // Auto remove after 5 seconds
                setTimeout(() => {
                    toast.style.animation = "fadeOut 0.3s forwards";
                    setTimeout(() => toast.remove(), 300);
                }, 5000);
            }

            function markAllRead() {
                // In a real app we'd call an API endpoint here to mark all as read in DB
                const badge = document.getElementById("notifBadge");
                if (badge) badge.remove();
                
                // Clear list visually
                const list = document.getElementById("notifList");
                if (list) {
                    list.innerHTML = '<div class="p-4 text-center text-muted small" id="noNotifsMsg">No new notifications</div>';
                }
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
