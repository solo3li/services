@{
    ViewData["Title"] = "Email SMTP Settings";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="h3 fw-bold">Email Configuration</h1>
            <p class="text-muted">Configure SMTP settings for system notifications and transactional emails</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="glass-card rounded-4 p-4 p-md-5">
                <form asp-action="UpdateEmailSettings" method="post">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label class="form-label text-muted small fw-bold">SMTP Host</label>
                            <input type="text" name="host" class="form-control bg-dark text-white border-secondary" placeholder="smtp.gmail.com" value="smtp.gmail.com">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small fw-bold">Port</label>
                            <input type="number" name="port" class="form-control bg-dark text-white border-secondary" placeholder="587" value="587">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Username</label>
                            <input type="text" name="username" class="form-control bg-dark text-white border-secondary" placeholder="notifications@yourdomain.com">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small fw-bold">Password</label>
                            <input type="password" name="password" class="form-control bg-dark text-white border-secondary" placeholder="SMTP Password">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label text-muted small fw-bold">From Email Address</label>
                            <input type="email" name="fromEmail" class="form-control bg-dark text-white border-secondary" placeholder="noreply@yourdomain.com">
                            <div class="form-text text-muted mt-1">This address will appear as the sender for all system emails.</div>
                        </div>
                        
                        <div class="col-12 mt-4">
                            <div class="p-3 rounded-3 bg-primary bg-opacity-10 border border-primary border-opacity-25 mb-4">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="enableSsl" checked>
                                    <label class="form-check-label text-white fw-medium" for="enableSsl">Enable SSL/TLS Security</label>
                                </div>
                            </div>
                            
                            <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold glow-btn">
                                <i class="bi bi-save me-2"></i> Save SMTP Configuration
                            </button>
                            <button type="button" class="btn btn-outline-info rounded-pill px-4 py-2 ms-2">
                                <i class="bi bi-send me-2"></i> Send Test Email
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        
        <div class="col-lg-4">
            <div class="glass-card rounded-4 p-4 h-100">
                <h5 class="fw-bold mb-3"><i class="bi bi-info-circle text-primary me-2"></i> SMTP Setup Guide</h5>
                <p class="text-muted small">For Gmail, use an <strong>App Password</strong> instead of your regular password if you have 2FA enabled.</p>
                <ul class="text-muted small ps-3">
                    <li class="mb-2">Ensure your server allows outgoing connections on port 587.</li>
                    <li class="mb-2">Verified "From Email" is required by some providers (like AWS SES or SendGrid).</li>
                    <li>SSL/TLS is highly recommended for security.</li>
                </ul>
                <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="small text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i> Current Status: Valid</span>
                </div>
            </div>
        </div>
    </div>
</div>
