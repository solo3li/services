@using Microsoft.AspNetCore.Identity
@using ServicesApp.Models.Entities
@model List<ApplicationUser>
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "User Management";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold">User Management</h1>
                <p class="text-muted">View and manage all registered users</p>
            </div>
            <button type="button" class="btn btn-primary rounded-pill px-4 glow-btn" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                <i class="bi bi-person-plus-fill me-2"></i> Add Admin
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="glass-card rounded-4 p-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="border-secondary text-muted small py-3">User</th>
                        <th class="border-secondary text-muted small py-3">Email</th>
                        <th class="border-secondary text-muted small py-3">Type</th>
                        <th class="border-secondary text-muted small py-3">Roles</th>
                        <th class="border-secondary text-muted small py-3">Status</th>
                        <th class="border-secondary text-muted small py-3 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @foreach (var user in Model)
                    {
                        var isAdmin = await UserManager.IsInRoleAsync(user, "Admin");
                        <tr>
                            <td class="border-secondary py-3">
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(user.Avatar))
                                    {
                                        <img src="@user.Avatar" class="rounded-circle me-3" width="36" height="36" alt="">
                                    }
                                    else
                                    {
                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold" style="width: 36px; height: 36px; font-size: 14px;">
                                            @(user.FullName.Substring(0, 1))
                                        </div>
                                    }
                                    <div class="fw-bold">@user.FullName</div>
                                </div>
                            </td>
                            <td class="border-secondary py-3 text-muted">@user.Email</td>
                            <td class="border-secondary py-3">
                                @if (user.IsExecutor)
                                {
                                    <span class="badge bg-success rounded-pill px-2 py-1 small"><i class="bi bi-briefcase me-1"></i> Executor</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary rounded-pill px-2 py-1 small"><i class="bi bi-person me-1"></i> Student</span>
                                }
                            </td>
                            <td class="border-secondary py-3">
                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger rounded-pill px-2 py-1 small">Admin</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="border-secondary py-3">
                                @if (user.IsActive)
                                {
                                    <span class="text-success small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Active</span>
                                }
                                else
                                {
                                    <span class="text-danger small fw-bold"><i class="bi bi-circle-fill" style="font-size: 8px;"></i> Suspended</span>
                                }
                            </td>
                            <td class="border-secondary py-3 text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="UpdateUserRole" method="post" class="d-inline">
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <input type="hidden" name="role" value="Admin" />
                                        <input type="hidden" name="addToRole" value="@(!isAdmin)" />
                                        @if (isAdmin)
                                        {
                                            <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-2" title="Remove Admin Role" onclick="return confirm('Remove admin privileges from this user?');"><i class="bi bi-shield-lock"></i></button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-info btn-sm rounded-pill px-2" title="Make Admin"><i class="bi bi-shield-plus"></i></button>
                                        }
                                    </form>

                                    <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @if (user.IsActive)
                                        {
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Are you sure you want to suspend this user?');">Suspend</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3">Activate</button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create Admin Modal -->
<div class="modal fade" id="createAdminModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-secondary rounded-4">
            <form asp-action="CreateAdmin" method="post">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title fw-bold">Create Admin User</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="fullName" class="form-control bg-dark text-white border-secondary" required placeholder="John Doe">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Email Address <span class="text-danger">*</span></label>
                        <input type="email" name="email" class="form-control bg-dark text-white border-secondary" required placeholder="admin@example.com">
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">Password <span class="text-danger">*</span></label>
                        <input type="password" name="password" class="form-control bg-dark text-white border-secondary" required placeholder="Strong password">
                        <div class="form-text text-muted mt-1" style="font-size: 0.75rem;">Must contain at least 6 characters, uppercase, lowercase, number, and special character.</div>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 glow-btn">Create Admin</button>
                </div>
            </form>
        </div>
    </div>
</div>
