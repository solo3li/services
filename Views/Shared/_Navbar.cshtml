@using Microsoft.AspNetCore.Identity
@using ServicesApp.Models.Entities
@using ServicesApp.Services
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NotificationService NotificationService
@{
    var isAuthenticated = SignInManager.IsSignedIn(User);
    ApplicationUser? user = null;
    int unreadNotifs = 0;
    
    if (isAuthenticated)
    {
        user = await UserManager.GetUserAsync(User);
        if (user != null)
        {
            unreadNotifs = await NotificationService.GetUnreadCountAsync(user.Id);
        }
    }
}

<nav class="navbar navbar-expand-lg navbar-dark fixed-top py-3">
    <div class="container">
        <a class="navbar-brand fw-bold text-white fs-4" asp-area="" asp-controller="Home" asp-action="Index">
            <i class="bi bi-layers-fill text-primary me-2"></i>SERVADO
        </a>
        
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarMain">
            <form class="d-flex mx-lg-4 my-3 my-lg-0 flex-grow-1" style="max-width: 400px;" asp-controller="Home" asp-action="Search" method="get">
                <div class="input-group">
                    <input class="form-control bg-dark border-secondary text-white" type="search" name="q" placeholder="Search services..." aria-label="Search">
                    <button class="btn btn-primary px-3" type="submit"><i class="bi bi-search"></i></button>
                </div>
            </form>

            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Categories">Categories</a>
                </li>
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-warning" asp-controller="Admin" asp-action="Dashboard">Admin Panel</a>
                    </li>
                }
            </ul>

            <ul class="navbar-nav ms-auto align-items-lg-center">
                @if (isAuthenticated && user != null)
                {
                    <li class="nav-item dropdown me-3">
                        <a class="nav-link position-relative" href="#" id="notifDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="bi bi-bell fs-5"></i>
                            @if (unreadNotifs > 0)
                            {
                                <span class="position-absolute top-25 start-75 translate-middle p-1 bg-danger border border-light rounded-circle" id="notifBadge">
                                    <span class="visually-hidden">New alerts</span>
                                </span>
                            }
                        </a>
                        <div class="dropdown-menu dropdown-menu-end glass-panel border-secondary p-0 mt-2 shadow-lg" style="width: 300px;">
                            <div class="p-3 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
                                <h6 class="mb-0 fw-bold text-white">Notifications</h6>
                                <button class="btn btn-sm btn-link text-muted p-0 text-decoration-none" onclick="markAllRead()">Mark all read</button>
                            </div>
                            <div id="notifList" class="overflow-auto" style="max-height: 300px;">
                                <div class="p-4 text-center text-muted small" id="noNotifsMsg" style="@(unreadNotifs > 0 ? "display:none;" : "")">
                                    No new notifications
                                </div>
                            </div>
                            <div class="p-2 border-top border-secondary border-opacity-25 text-center">
                                <a href="#" class="small text-decoration-none text-primary">View All</a>
                            </div>
                        </div>
                    </li>

                    <li class="nav-item me-3">
                        <a class="nav-link" asp-controller="Chat" asp-action="Conversations">
                            <i class="bi bi-chat-dots fs-5"></i>
                        </a>
                    </li>

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            @if (!string.IsNullOrEmpty(user.Avatar))
                            {
                                <img src="@user.Avatar" class="rounded-circle me-2" width="32" height="32" alt="">
                            }
                            else
                            {
                                <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2 text-white fw-bold" style="width: 32px; height: 32px; font-size: 14px;">
                                    @(user.FullName.Substring(0, 1))
                                </div>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-panel border-secondary mt-2 shadow-lg">
                            <li class="px-3 py-2 border-bottom border-secondary border-opacity-25 mb-2">
                                <div class="fw-bold text-white">@user.FullName</div>
                                <div class="small text-muted">Balance: <span class="text-success">$@user.WalletBalance.ToString("0.00")</span></div>
                            </li>
                            
                            <!-- Student Links -->
                            <li><h6 class="dropdown-header text-primary">Buying</h6></li>
                            <li><a class="dropdown-item text-light" asp-controller="Orders" asp-action="Index">My Orders</a></li>
                            
                            <!-- Executor Links -->
                            <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                            <li><h6 class="dropdown-header text-accent">Selling</h6></li>
                            @if (user.IsExecutor)
                            {
                                <li><a class="dropdown-item text-light" asp-controller="Orders" asp-action="ExecutorOrders">Manage Orders</a></li>
                                <li><a class="dropdown-item text-light" asp-controller="Services" asp-action="Create">Create Service</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item text-light" asp-controller="Kyc" asp-action="Status">Become an Executor</a></li>
                            }

                            <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                            <li><a class="dropdown-item text-light" asp-controller="Tickets" asp-action="List">Support Tickets</a></li>
                            <li>
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link fw-medium" asp-controller="Auth" asp-action="Login">Sign In</a>
                    </li>
                    <li class="nav-item ms-2">
                        <a class="btn btn-primary rounded-pill px-4 glow-btn" asp-controller="Auth" asp-action="Register">Join Now</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<!-- Push main content down so it's not hidden behind fixed navbar -->
<div style="height: 76px;"></div>
