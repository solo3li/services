@using ServicesApp.Models.Entities
@model Order
@{
    ViewData["Title"] = "Order Details #" + Model.Id;
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <div>
                <h1 class="h3 fw-bold">Order #@Model.Id</h1>
                <a asp-action="Index" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i> Back to Orders</a>
            </div>
            @{
                var badgeClass = Model.Status switch
                {
                    OrderStatus.Pending => "bg-warning text-dark",
                    OrderStatus.InProgress => "bg-info text-dark",
                    OrderStatus.Delivered => "bg-primary",
                    OrderStatus.Completed => "bg-success",
                    OrderStatus.Cancelled => "bg-danger",
                    _ => "bg-secondary"
                };
            }
            <span class="badge @badgeClass rounded-pill fs-6 px-3 py-2">@Model.Status</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="glass-card rounded-4 p-4 mb-4">
                <h5 class="fw-bold border-bottom border-secondary border-opacity-25 pb-2 mb-3">Order Information</h5>
                <div class="row">
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Service</div>
                        <div class="fw-bold">@Model.Service.Title</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Total Price</div>
                        <div class="fw-bold text-success">$@Model.TotalPrice.ToString("0.00")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Created At</div>
                        <div>@Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                    </div>
                    <div class="col-sm-6 mb-3">
                        <div class="text-muted small fw-bold text-uppercase">Delivery Deadline</div>
                        <div>@Model.CreatedAt.AddDays(Model.Service.DeliveryDays).ToString("MMM dd, yyyy")</div>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="text-muted small fw-bold text-uppercase mb-2">Requirements / Notes</div>
                    <div class="p-3 bg-dark bg-opacity-50 rounded-3 border border-secondary border-opacity-25">
                        @(string.IsNullOrEmpty(Model.Requirements) ? "No requirements provided." : Model.Requirements)
                    </div>
                </div>
            </div>
            
            <div class="glass-card rounded-4 p-4">
                <h5 class="fw-bold border-bottom border-secondary border-opacity-25 pb-2 mb-3">Admin Actions</h5>
                <p class="text-muted small">Manually override the status of this order. Use with caution.</p>
                
                <form asp-action="ChangeStatus" method="post" class="d-flex align-items-center">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <select name="newStatus" class="form-select bg-dark text-white border-secondary w-auto me-3">
                        @foreach (var status in Enum.GetValues(typeof(OrderStatus)))
                        {
                            <option value="@status" selected="@(Model.Status.Equals(status))">@status</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 glow-btn" onclick="return confirm('Change order status?');">Update Status</button>
                </form>
            </div>
        </div>
        
        <div class="col-12 col-lg-4">
            <div class="glass-card rounded-4 p-4 mb-4">
                <h5 class="fw-bold border-bottom border-secondary border-opacity-25 pb-2 mb-3">Client</h5>
                <div class="d-flex align-items-center">
                    @if (!string.IsNullOrEmpty(Model.Client.Avatar))
                    {
                        <img src="@Model.Client.Avatar" class="rounded-circle me-3" width="48" height="48" alt="">
                    }
                    else
                    {
                        <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold" style="width: 48px; height: 48px; font-size: 18px;">
                            @(Model.Client.FullName.Substring(0, 1))
                        </div>
                    }
                    <div>
                        <div class="fw-bold">@Model.Client.FullName</div>
                        <div class="small text-muted">@Model.Client.Email</div>
                    </div>
                </div>
            </div>
            
            <div class="glass-card rounded-4 p-4">
                <h5 class="fw-bold border-bottom border-secondary border-opacity-25 pb-2 mb-3">Executor</h5>
                @if (Model.Executor != null)
                {
                    <div class="d-flex align-items-center">
                        @if (!string.IsNullOrEmpty(Model.Executor.Avatar))
                        {
                            <img src="@Model.Executor.Avatar" class="rounded-circle me-3" width="48" height="48" alt="">
                        }
                        else
                        {
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold" style="width: 48px; height: 48px; font-size: 18px;">
                                @(Model.Executor.FullName.Substring(0, 1))
                            </div>
                        }
                        <div>
                            <div class="fw-bold">@Model.Executor.FullName</div>
                            <div class="small text-muted">@Model.Executor.Email</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted font-italic">No executor assigned</div>
                }
            </div>
        </div>
    </div>
</div>
