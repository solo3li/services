@using ServicesApp.Models.Entities
@model List<KycRequest>
@{
    ViewData["Title"] = "KYC Applications";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">KYC Applications</h1>
            <p class="text-muted mb-0">Review pending executor applications</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 rounded-3 mb-4">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        </div>
    }

    @if (!Model.Any())
    {
        <div class="glass-panel p-5 text-center rounded-4">
            <div class="mb-4">
                <i class="bi bi-check-all text-success" style="font-size: 4rem;"></i>
            </div>
            <h3 class="h4">All caught up!</h3>
            <p class="text-muted">There are no pending KYC applications to review.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var kyc in Model)
            {
                <div class="col-12 col-xxl-6">
                    <div class="glass-card rounded-4 p-4 h-100 position-relative">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(kyc.User.Avatar))
                                {
                                    <img src="@kyc.User.Avatar" class="rounded-circle me-3" width="48" height="48" alt="">
                                }
                                else
                                {
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fs-5 fw-bold" style="width: 48px; height: 48px;">
                                        @(kyc.User.FullName.Substring(0, 1))
                                    </div>
                                }
                                <div>
                                    <h5 class="fw-bold mb-0">@kyc.User.FullName</h5>
                                    <div class="text-muted small">@kyc.User.Email &bull; Submitted @kyc.SubmittedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        </div>

                        <div class="row g-4 mb-4">
                            <!-- Verification Images -->
                            <div class="col-12 col-md-6">
                                <h6 class="fw-bold text-muted small text-uppercase mb-2">ID Document</h6>
                                <div class="bg-dark rounded-3 overflow-hidden d-flex align-items-center justify-content-center" style="height: 150px;">
                                    @if (!string.IsNullOrEmpty(kyc.IdCardImageUrl))
                                    {
                                        <a href="@kyc.IdCardImageUrl" target="_blank" class="w-100 h-100">
                                            <img src="@kyc.IdCardImageUrl" class="w-100 h-100 object-fit-cover" alt="ID Card">
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No ID provided</span>
                                    }
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <h6 class="fw-bold text-muted small text-uppercase mb-2">Selfie</h6>
                                <div class="bg-dark rounded-3 overflow-hidden d-flex align-items-center justify-content-center" style="height: 150px;">
                                    @if (!string.IsNullOrEmpty(kyc.SelfieUrl))
                                    {
                                        <a href="@kyc.SelfieUrl" target="_blank" class="w-100 h-100">
                                            <img src="@kyc.SelfieUrl" class="w-100 h-100 object-fit-cover" alt="Selfie">
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No selfie provided</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <h6 class="fw-bold text-muted small text-uppercase mb-2">Professional Details</h6>
                            <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-light small mb-2" style="max-height: 100px; overflow-y: auto;">
                                <strong>Bio:</strong><br/>
                                @kyc.Bio
                            </div>
                            <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-light small">
                                <strong>Skills:</strong> @kyc.Skills
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-auto pt-3 border-top border-secondary border-opacity-25">
                            <button type="button" class="btn btn-outline-danger px-4 rounded-pill" data-bs-toggle="modal" data-bs-target="#rejectModal-@kyc.Id">Reject</button>
                            <form asp-action="ApproveKyc" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@kyc.Id" />
                                <button type="submit" class="btn btn-success px-4 rounded-pill glow-btn">Approve</button>
                            </form>
                        </div>
                    </div>

                    <!-- Reject Modal -->
                    <div class="modal fade" id="rejectModal-@kyc.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content bg-dark border-secondary">
                                <form asp-action="RejectKyc" method="post">
                                    <div class="modal-header border-secondary border-opacity-25">
                                        <h5 class="modal-title">Reject KYC Application</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="id" value="@kyc.Id" />
                                        <p class="text-muted mb-3">Please provide a reason for rejection. This will be sent to the user.</p>
                                        <textarea name="reason" class="form-control bg-dark text-white border-secondary" rows="3" required placeholder="e.g. ID image is blurry..."></textarea>
                                    </div>
                                    <div class="modal-footer border-secondary border-opacity-25">
                                        <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Rejection</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
