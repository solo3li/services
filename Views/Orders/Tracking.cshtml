@using ServicesApp.Models.Entities
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@model Order
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    var currentUser = await UserManager.GetUserAsync(User);
    bool isClient = currentUser?.Id == Model.ClientId;
}

<div class="container py-5">
    <div class="row g-5">
        <!-- Main Content -->
        <div class="col-12 col-lg-8">
            <div class="d-flex align-items-center mb-4">
                <a href="@(isClient ? "/Orders" : "/Orders/ExecutorOrders")" class="btn btn-outline-secondary btn-sm rounded-pill me-3"><i class="bi bi-arrow-left"></i> Back to Orders</a>
                <h1 class="h3 fw-bold mb-0">Order Tracking</h1>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-4 mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 rounded-4 mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <!-- Order Status Timeline -->
            <div class="glass-card p-4 p-md-5 mb-5 overflow-hidden position-relative">
                <h3 class="h5 fw-bold mb-5">Order Progress</h3>
                
                <div class="position-relative">
                    <div class="progress position-absolute top-50 start-0 translate-middle-y w-100" style="height: 4px; z-index: 0; background-color: rgba(255,255,255,0.1);">
                        @{
                            var progress = Model.Status switch {
                                OrderStatus.Pending => 25,
                                OrderStatus.InProgress => 50,
                                OrderStatus.Delivered => 75,
                                OrderStatus.Completed => 100,
                                OrderStatus.Disputed => 100,
                                _ => 0
                            };
                            var progressColor = (Model.Status == OrderStatus.Cancelled || Model.Status == OrderStatus.Disputed) ? "bg-danger" : "bg-primary";
                        }
                        <div class="progress-bar @progressColor" role="progressbar" style="width: @progress%" aria-valuenow="@progress" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                    
                    <div class="d-flex justify-content-between position-relative z-1">
                        <!-- Step 1 -->
                        <div class="text-center" style="width: 80px; margin-left: -20px;">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 40px; height: 40px; border: 4px solid #1e1e2d;">
                                <i class="bi bi-cart-check"></i>
                            </div>
                            <div class="small fw-bold">Placed</div>
                            <div class="small text-muted" style="font-size: 0.7rem;">@Model.CreatedAt.ToString("MMM dd")</div>
                        </div>

                        <!-- Step 2 -->
                        <div class="text-center" style="width: 80px;">
                            @{ var step2Active = (Model.Status >= OrderStatus.InProgress || Model.Status == OrderStatus.Disputed) && Model.Status != OrderStatus.Cancelled; }
                            <div class="@(step2Active ? "bg-primary text-white" : "bg-dark text-muted") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 transition-all" style="width: 40px; height: 40px; border: 4px solid #1e1e2d;">
                                <i class="bi bi-gear @(step2Active && Model.Status != OrderStatus.Disputed ? "spin-slow" : "")"></i>
                            </div>
                            <div class="small fw-bold @(step2Active ? "" : "text-muted")">In Progress</div>
                        </div>

                        <!-- Step 3 -->
                        <div class="text-center" style="width: 80px;">
                            @{ var step3Active = (Model.Status >= OrderStatus.Delivered || Model.Status == OrderStatus.Disputed) && Model.Status != OrderStatus.Cancelled; }
                            <div class="@(step3Active ? "bg-primary text-white" : "bg-dark text-muted") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 transition-all" style="width: 40px; height: 40px; border: 4px solid #1e1e2d;">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="small fw-bold @(step3Active ? "" : "text-muted")">Delivered</div>
                            @if (Model.DeliveredAt.HasValue) {
                                <div class="small text-muted" style="font-size: 0.7rem;">@Model.DeliveredAt.Value.ToString("MMM dd")</div>
                            }
                        </div>

                        <!-- Step 4 -->
                        <div class="text-center" style="width: 80px; margin-right: -20px;">
                            @{ 
                                var step4Active = Model.Status == OrderStatus.Completed || Model.Status == OrderStatus.Disputed; 
                                var step4Color = Model.Status == OrderStatus.Disputed ? "bg-danger" : "bg-success";
                                var step4Text = Model.Status == OrderStatus.Disputed ? "Disputed" : "Completed";
                            }
                            <div class="@(step4Active ? step4Color + " text-white" : "bg-dark text-muted") rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 transition-all" style="width: 40px; height: 40px; border: 4px solid #1e1e2d;">
                                <i class="bi @(Model.Status == OrderStatus.Disputed ? "bi-exclamation-triangle" : "bi-check2-all")"></i>
                            </div>
                            <div class="small fw-bold @(step4Active ? (Model.Status == OrderStatus.Disputed ? "text-danger" : "text-success") : "text-muted")">@step4Text</div>
                        </div>
                    </div>
                </div>

                @if (Model.Status == OrderStatus.Cancelled)
                {
                    <div class="alert alert-danger bg-danger bg-opacity-10 text-danger border-danger border-opacity-25 rounded-3 mt-5 mb-0">
                        <i class="bi bi-x-circle me-2"></i> <strong>Order Cancelled:</strong> @Model.CancellationReason
                    </div>
                }
                @if (Model.Status == OrderStatus.Disputed)
                {
                    <div class="alert alert-warning bg-warning bg-opacity-10 text-warning border-warning border-opacity-25 rounded-3 mt-5 mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i> <strong>Order Disputed:</strong> An admin has been notified and will review the transaction. Use the chat to provide evidence.
                    </div>
                }
            </div>

            <!-- Action Area based on Status & Role -->
            @if (Model.Status != OrderStatus.Completed && Model.Status != OrderStatus.Cancelled)
            {
                <div class="glass-card p-4 mb-5 border-primary border-opacity-50" style="border-left: 4px solid #7c3aed !important;">
                    @if (isClient)
                    {
                        if (Model.Status == OrderStatus.Pending)
                        {
                            <h4 class="h6 fw-bold">Waiting for Executor</h4>
                            <p class="text-muted small mb-0">The freelancer will start working on your order soon.</p>
                        }
                        else if (Model.Status == OrderStatus.InProgress)
                        {
                            <h4 class="h6 fw-bold">Order in Progress</h4>
                            <p class="text-muted small mb-0">The freelancer is currently working on your project. You will be notified when it's delivered.</p>
                        }
                        else if (Model.Status == OrderStatus.Delivered)
                        {
                            <h4 class="h6 fw-bold text-primary mb-3">Delivery Received!</h4>
                            <p class="text-muted small mb-4">Please review the delivery. If everything is good, mark the order as complete.</p>
                            
                            @if (!string.IsNullOrEmpty(Model.DeliveryNote))
                            {
                                <div class="bg-dark bg-opacity-50 p-3 rounded-3 mb-3">
                                    <p class="small mb-0 fst-italic">"@Model.DeliveryNote"</p>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.DeliveryFileUrl))
                            {
                                <a href="@Model.DeliveryFileUrl" target="_blank" class="btn btn-outline-light btn-sm rounded-pill mb-4"><i class="bi bi-download me-1"></i> Download Delivery File</a>
                            }
                            
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@OrderStatus.Completed" />
                                <button type="submit" class="btn btn-success rounded-pill px-4 glow-btn"><i class="bi bi-check-circle me-1"></i> Mark as Completed</button>
                            </form>
                        }
                    }
                    else // Executor
                    {
                        if (Model.Status == OrderStatus.Pending)
                        {
                            <h4 class="h6 fw-bold mb-3">New Order Received</h4>
                            <p class="text-muted small mb-3">Review the requirements and start working.</p>
                            <form asp-action="UpdateStatus" method="post">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@OrderStatus.InProgress" />
                                <button type="submit" class="btn btn-primary rounded-pill px-4 glow-btn">Start Working</button>
                            </form>
                        }
                        else if (Model.Status == OrderStatus.InProgress)
                        {
                            <h4 class="h6 fw-bold mb-3">Deliver Your Work</h4>
                            <form asp-action="UpdateStatus" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <input type="hidden" name="status" value="@OrderStatus.Delivered" />
                                
                                <div class="mb-3">
                                    <label class="form-label text-muted small">Delivery Note</label>
                                    <textarea name="note" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Here is your final delivery..."></textarea>
                                </div>
                                
                                <div class="mb-4">
                                    <label class="form-label text-muted small">Delivery File</label>
                                    <input type="file" name="deliveryFile" class="form-control bg-dark text-white border-secondary">
                                </div>
                                
                                <button type="submit" class="btn btn-primary rounded-pill px-4 glow-btn">Send Delivery</button>
                            </form>
                        }
                        else if (Model.Status == OrderStatus.Delivered)
                        {
                            <h4 class="h6 fw-bold text-success mb-2"><i class="bi bi-check-circle me-1"></i> Delivery Sent</h4>
                            <p class="text-muted small mb-0">Waiting for the client to review and complete the order.</p>
                        }
                    }
                </div>
            }
            
            <!-- Review Section for Client -->
            @if (Model.Status == OrderStatus.Completed && isClient && Model.Review == null)
            {
                <div class="glass-card p-4 p-md-5 mb-5 border-success border-opacity-50">
                    <h4 class="h5 fw-bold text-white mb-3"><i class="bi bi-star-fill text-warning me-2"></i> Rate this service</h4>
                    <p class="text-muted small mb-4">How was your experience with this freelancer? Your feedback helps the community.</p>
                    
                    <form asp-action="SubmitReview" method="post">
                        <input type="hidden" name="orderId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold">Rating</label>
                            <div class="d-flex gap-3">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="radio" name="rating" id="rating@i" value="@i" required @(i == 5 ? "checked" : "")>
                                        <label class="form-check-label text-white" for="rating@i">@i <i class="bi bi-star-fill text-warning small"></i></label>
                                    </div>
                                }
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label text-muted small fw-bold">Comment</label>
                            <textarea name="comment" class="form-control bg-dark text-white border-secondary" rows="3" placeholder="Describe your experience..." required></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary rounded-pill px-5 glow-btn">Submit Review</button>
                    </form>
                </div>
            }
            else if (Model.Status == OrderStatus.Completed && Model.Review != null)
            {
                <div class="glass-card p-4 p-md-5 mb-5">
                    <h4 class="h5 fw-bold text-white mb-3">Service Review</h4>
                    <div class="d-flex align-items-center mb-2">
                        <div class="text-warning me-2">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star@(i <= Model.Review.Rating ? "-fill" : "")"></i>
                            }
                        </div>
                        <span class="text-muted small">@Model.Review.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </div>
                    <p class="text-light mb-0">"@Model.Review.Comment"</p>
                </div>
            }

            <!-- Requirements Details -->
            <div class="glass-card p-4 p-md-5">
                <h3 class="h5 fw-bold mb-4 border-bottom border-secondary border-opacity-25 pb-3">Requirements</h3>
                <div class="text-light" style="white-space: pre-line;">@Model.Requirements</div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-12 col-lg-4">
            <div class="glass-panel p-4 rounded-4 mb-4">
                <h3 class="h6 text-muted text-uppercase fw-bold mb-3">Order Details</h3>
                
                <div class="d-flex align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
                    <div class="rounded-3 overflow-hidden me-3 flex-shrink-0" style="width: 60px; height: 60px; background: #1e1e2d;">
                        @if (!string.IsNullOrEmpty(Model.Service.Thumbnail))
                        {
                            <img src="@Model.Service.Thumbnail" class="w-100 h-100 object-fit-cover" alt="">
                        }
                    </div>
                    <div>
                        <div class="fw-bold mb-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@Model.Service.Title</div>
                        <div class="text-muted small">Order #@Model.Id</div>
                    </div>
                </div>
                
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Ordered by</span>
                    <span class="fw-bold">@Model.Client.FullName</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Executed by</span>
                    <span class="fw-bold">@Model.Executor?.FullName</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Order Date</span>
                    <span class="fw-bold">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
                
                <div class="d-flex justify-content-between mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <span class="h5 mb-0 fw-bold">Total</span>
                    <span class="h5 mb-0 fw-bold text-success">$@Model.TotalPrice.ToString("0.00")</span>
                </div>
            </div>

            <!-- Open Order Chat Button -->
            <a asp-controller="Chat" asp-action="OrderChat" asp-route-orderId="@Model.Id" class="btn btn-primary w-100 py-3 rounded-pill fw-bold glow-btn mb-3">
                <i class="bi bi-chat-dots me-2"></i> Open Order Chat
            </a>
            
            @if (Model.Status != OrderStatus.Completed && Model.Status != OrderStatus.Cancelled && Model.Status != OrderStatus.Disputed)
            {
                <form asp-action="UpdateStatus" method="post" class="mb-3">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="status" value="@OrderStatus.Disputed" />
                    <button type="submit" class="btn btn-outline-danger w-100 py-2 rounded-pill small" onclick="return confirm('Are you sure you want to open a dispute? An admin will review the case.');">
                        <i class="bi bi-exclamation-triangle me-1"></i> Open Dispute
                    </button>
                </form>
            }
            
            <div class="text-center">
                <a asp-controller="Tickets" asp-action="Open" asp-route-orderId="@Model.Id" class="text-muted small text-decoration-none"><i class="bi bi-life-preserver me-1"></i> Need help? Open a ticket</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .spin-slow { animation: spin 4s linear infinite; }
        @@keyframes spin { 100% { transform: rotate(360deg); } }
        .glow-success-true { box-shadow: 0 0 15px rgba(16, 185, 129, 0.5); }
    </style>
}
