@using ServicesApp.Models.Entities
@model KycRequest
@{
    ViewData["Title"] = "KYC Status";
    var status = (ExecutorStatus)ViewBag.ExecutorStatus;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <h1 class="h3 fw-bold mb-4">Executor Application Status</h1>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success bg-success bg-opacity-10 text-success border-success border-opacity-25 rounded-4 mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            <div class="glass-card p-5 rounded-4 text-center">
                @if (status == ExecutorStatus.None)
                {
                    <div class="mb-4">
                        <i class="bi bi-briefcase text-muted" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="h4 mb-3">Become an Executor</h2>
                    <p class="text-muted mb-4">Start offering your services and earning money on our platform. You need to verify your identity first.</p>
                    <a asp-action="Submit" class="btn btn-primary rounded-pill px-4">Start Application</a>
                }
                else if (status == ExecutorStatus.Pending)
                {
                    <div class="mb-4">
                        <div class="spinner-border text-warning" style="width: 4rem; height: 4rem;" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <h2 class="h4 text-warning mb-3">Application Under Review</h2>
                    <p class="text-muted mb-0">We have received your application. Our team is currently reviewing it. This usually takes 1-2 business days.</p>
                    <div class="mt-4 pt-4 border-top border-secondary border-opacity-25 text-start">
                        <h4 class="h6 text-muted mb-2">Submitted on</h4>
                        <p>@Model?.SubmittedAt.ToString("MMMM dd, yyyy")</p>
                    </div>
                }
                else if (status == ExecutorStatus.Approved)
                {
                    <div class="mb-4">
                        <i class="bi bi-check-circle-fill text-success glow-text" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="h4 text-success mb-3">Application Approved!</h2>
                    <p class="text-muted mb-4">Congratulations! You are now an official executor. You can start creating and selling services.</p>
                    <a asp-controller="Services" asp-action="Create" class="btn btn-success rounded-pill px-4 glow-btn">Create Your First Service</a>
                }
                else if (status == ExecutorStatus.Rejected)
                {
                    <div class="mb-4">
                        <i class="bi bi-x-circle-fill text-danger" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="h4 text-danger mb-3">Application Rejected</h2>
                    <p class="text-muted mb-3">Unfortunately, your application was not approved at this time.</p>
                    
                    @if (!string.IsNullOrEmpty(Model?.RejectionNote))
                    {
                        <div class="bg-dark bg-opacity-50 p-3 rounded-3 text-start mb-4">
                            <p class="mb-0 small text-danger"><i class="bi bi-info-circle me-1"></i> <strong>Reason:</strong> @Model.RejectionNote</p>
                        </div>
                    }
                    
                    <a asp-action="Submit" class="btn btn-outline-danger rounded-pill px-4">Update Application & Resubmit</a>
                }
                else if (status == ExecutorStatus.Suspended)
                {
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle-fill text-warning" style="font-size: 4rem;"></i>
                    </div>
                    <h2 class="h4 text-warning mb-3">Account Suspended</h2>
                    <p class="text-muted mb-0">Your executor privileges have been temporarily suspended. Please contact support for more information.</p>
                }
            </div>
        </div>
    </div>
</div>
