@using ServicesApp.Models.Entities
@model List<Message>
@{
    ViewData["Title"] = "Chat Log Detail";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-primary text-decoration-none">Chat Monitor</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Log Detail</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold">Conversation: <span class="text-primary">@ViewBag.User1</span> & <span class="text-primary">@ViewBag.User2</span></h1>
            <p class="text-muted small">Key: @ViewBag.Key</p>
        </div>
    </div>

    <div class="glass-card rounded-4 overflow-hidden">
        <div class="bg-dark bg-opacity-50 p-3 border-bottom border-secondary border-opacity-25 d-flex justify-content-between align-items-center">
            <span class="small fw-bold text-uppercase text-muted">Message History</span>
            <span class="badge bg-primary">@Model.Count Messages</span>
        </div>
        
        <div class="p-4" style="max-height: 600px; overflow-y: auto; display: flex; flex-direction: column-reverse;">
            <div class="d-flex flex-column gap-3">
                @foreach (var msg in Model)
                {
                    <div class="d-flex flex-column @(msg.Sender.FullName == ViewBag.User1 ? "align-items-start" : "align-items-end")">
                        <div class="small text-muted mb-1 px-2">@msg.Sender.FullName • @msg.SentAt.ToString("HH:mm")</div>
                        <div class="p-3 rounded-4 @(msg.Sender.FullName == ViewBag.User1 ? "bg-dark border border-secondary text-white" : "bg-primary text-white") shadow-sm" style="max-width: 80%;">
                            @msg.Content
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
