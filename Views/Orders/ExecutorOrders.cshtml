@using ServicesApp.Models.Entities
@model List<Order>
@{
    ViewData["Title"] = "Executor Orders";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="h3 fw-bold mb-1">Incoming Orders</h1>
            <p class="text-muted mb-0">Manage and deliver your client's projects</p>
        </div>
        <div class="glass-badge px-3 py-2 text-white">
            <span class="text-muted small me-2">Total Earnings:</span>
            <span class="fw-bold text-success">$@Model.Where(o => o.Status == OrderStatus.Completed).Sum(o => o.TotalPrice).ToString("0.00")</span>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="glass-panel p-5 text-center rounded-4">
            <div class="mb-4">
                <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
            </div>
            <h3 class="h4">No orders yet</h3>
            <p class="text-muted mb-4">You haven't received any orders yet. Make sure your services are active and well-described.</p>
        </div>
    }
    else
    {
        <div class="glass-card rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead class="bg-dark bg-opacity-75">
                        <tr>
                            <th class="border-secondary py-3 px-4">Service</th>
                            <th class="border-secondary py-3">Client</th>
                            <th class="border-secondary py-3">Date</th>
                            <th class="border-secondary py-3">Price</th>
                            <th class="border-secondary py-3">Status</th>
                            <th class="border-secondary py-3 text-end px-4">Action</th>
                        </tr>
                    </thead>
                    <tbody class="border-top-0">
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="border-secondary py-3 px-4">
                                    <div class="fw-bold text-truncate" style="max-width: 250px;" title="@order.Service.Title">@order.Service.Title</div>
                                    <div class="text-muted small">Order #@order.Id</div>
                                </td>
                                <td class="border-secondary py-3">
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(order.Client?.Avatar))
                                        {
                                            <img src="@order.Client.Avatar" class="rounded-circle me-2" width="24" height="24" alt="">
                                        }
                                        else
                                        {
                                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2 text-white" style="width: 24px; height: 24px; font-size: 10px;">
                                                @(order.Client?.FullName.Substring(0, 1) ?? "U")
                                            </div>
                                        }
                                        <span class="small">@order.Client?.FullName</span>
                                    </div>
                                </td>
                                <td class="border-secondary py-3 text-muted small">
                                    @order.CreatedAt.ToString("MMM dd, yyyy")
                                </td>
                                <td class="border-secondary py-3 fw-bold text-success">
                                    $@order.TotalPrice.ToString("0.00")
                                </td>
                                <td class="border-secondary py-3">
                                    @{
                                        var badgeClass = order.Status switch
                                        {
                                            OrderStatus.Pending => "bg-warning text-dark",
                                            OrderStatus.InProgress => "bg-info text-dark",
                                            OrderStatus.Delivered => "bg-primary",
                                            OrderStatus.Completed => "bg-success",
                                            OrderStatus.Cancelled => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass rounded-pill">@order.Status</span>
                                </td>
                                <td class="border-secondary py-3 text-end px-4">
                                    <a asp-action="Tracking" asp-route-id="@order.Id" class="btn btn-primary btn-sm rounded-pill px-3">Manage</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
