@model ServicesApp.Models.Entities.EmailTemplate
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-primary text-decoration-none">Templates</a></li>
                    <li class="breadcrumb-item active text-muted" aria-current="page">Edit</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold">Edit Template: <span class="text-primary">@Model.Name</span></h1>
            <p class="text-muted">Use placeholders like <code>{{UserName}}</code>, <code>{{OrderNumber}}</code>, or <code>{{Link}}</code> within the content.</p>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Name" />
        <input type="hidden" asp-for="Slug" />

        <div class="row">
            <div class="col-lg-8">
                <div class="glass-card rounded-4 p-4 p-md-5">
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">Email Subject</label>
                        <input asp-for="Subject" class="form-control bg-dark text-white border-secondary" placeholder="Email Subject Line">
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">HTML Body Content</label>
                        <textarea asp-for="Body" class="form-control bg-dark text-white border-secondary" rows="15" style="font-family: monospace; font-size: 0.9rem;"></textarea>
                        <span asp-validation-for="Body" class="text-danger small"></span>
                    </div>

                    <div class="pt-4 border-top border-secondary border-opacity-25">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2 fw-bold glow-btn">
                            <i class="bi bi-save me-2"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 ms-2">Cancel</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="glass-card rounded-4 p-4 sticky-top" style="top: 100px;">
                    <h5 class="fw-bold mb-3"><i class="bi bi-code-slash text-primary me-2"></i> Available Placeholders</h5>
                    <div class="d-flex flex-column gap-2">
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                            <code>{{UserName}}</code> - Full name of the recipient
                        </div>
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                            <code>{{OrderNumber}}</code> - ID of the related order
                        </div>
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                            <code>{{Link}}</code> - Call to action URL
                        </div>
                        <div class="p-2 rounded bg-dark border border-secondary border-opacity-25">
                            <code>{{AppName}}</code> - Application name
                        </div>
                    </div>
                    
                    <div class="mt-4 pt-3 border-top border-secondary border-opacity-25">
                        <div class="alert alert-info bg-info bg-opacity-10 text-info border-info border-opacity-25 small mb-0">
                            <i class="bi bi-info-circle me-1"></i> You can use standard HTML tags like <code>&lt;b&gt;</code>, <code>&lt;br&gt;</code>, and <code>&lt;a&gt;</code> for styling.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
